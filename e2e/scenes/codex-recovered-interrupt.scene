# A missed Interrupt is recovered after Compact, despite stale spool reloads.
size 90 12
meta hooks=1 epoch=200
scan demo 42 /tmp/api codex
hook demo 42 beforeSubmitPrompt @100 ~100000
hook demo 42 preCompact @110 ~110100
expect status demo 42 compact
hook demo 42 interrupt @120 ~120100 codex_rollout
expect status demo 42 stopped
expect screen contains stopped
expect screen contains ■
expect screen excludes working
expect screen excludes done

# Polling the old spool and reloading a cached scan cannot restore Compact.
hook demo 42 preCompact @110 ~110100
expect status demo 42 stopped
meta hooks=1 epoch=201
scan demo 42 /tmp/api codex
hook demo 42 preCompact @110 ~110100
started demo 42 100
expect status demo 42 stopped
expect screen excludes compact

# A new prompt in the same second wins; older recovery cannot stop it again.
hook demo 42 beforeSubmitPrompt @120 ~120200
expect status demo 42 working
expect screen contains working
hook demo 42 interrupt @120 ~120100 codex_rollout
expect status demo 42 working
expect screen excludes stopped
