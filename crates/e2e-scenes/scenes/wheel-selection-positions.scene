# Wheel (`scroll` → scroll_view): move-together, not gutter jump. Host notches
# are ±3. Dense multi-session board (tabs + activity) matches opening the
# board from another session.
#
# Covers: top/mid/bottom spotlight × notch size, ±1 screen-line hold, edges,
# G then scroll, and top→max in one burst (merged former view-scroll scene).
size 80 8
meta hooks=1
scan daily 1 /tmp/daily
scan daily 2 /tmp/daily2
scan lp 1 /tmp/lp
scan lp 2 /tmp/lp2
scan lp 3 /tmp/lp3
scan lp 8 /tmp/lp8
scan mysql_syncer 1 /tmp/ms
scan mysql_syncer 2 /tmp/ms2
scan ww 1 /tmp/ww1
scan ww 2 /tmp/ww2
scan ww 3 /tmp/ww3
scan ww 4 /tmp/ww4
scan ww 5 /tmp/ww5
scan ww 6 /tmp/ww6
scan zab 1 /tmp/zab1
scan zab 2 /tmp/zab2
scan zab 3 /tmp/zab3
place daily 1 0 self daily-review
place daily 2 1 notes daily-notes
place lp 1 0 master log_parser2
place lp 2 1 notes lp-notes
place lp 3 2 bench lp-bench
place lp 8 3 master lp-old
place mysql_syncer 1 0 main syncer
place mysql_syncer 2 1 worker sync-worker
place ww 1 0 self Morning-Review
place ww 2 1 zellij-overview overview
place ww 3 2 zellij-cursor-ua Session-Issue
place ww 4 3 agent-lab Roadmap
place ww 5 4 skill-distribution Skill-Stats
place ww 6 5 zellij-agent-resume resume
place zab 1 0 board zab-board
place zab 2 1 board zab-tui
place zab 3 2 notes zab-notes
hook ww 2 preToolUse Shell cargo test
hook ww 4 preToolUse Shell cargo build
hook lp 1 preToolUse Shell pytest
hook mysql_syncer 1 preToolUse Shell mysql
hook zab 1 preToolUse Shell cargo test --lib

# --- top + one notch ---
expect selected daily 1
expect topline 0
expect scrollbar thumb 0 1
scroll 3
expect topline 3
expect selected lp 1
expect screen contains log_parser2
expect screen excludes daily-review

# --- mid-list + one notch (activity keeps spotlight on lp 1 a beat) ---
scroll 3
expect topline 6
expect selected lp 1
expect screen contains lp-old

# --- mid-window ±1 keeps the screen line ---
scroll 1
expect topline 7
expect selected lp 2
scroll -1
expect topline 6
expect selected lp 1

# --- G at bottom + one notch up ---
key G
expect selected zab 3
expect topline 25
expect scrollbar thumb 4 5
scroll -3
expect topline 22
expect selected zab 1
expect screen contains zab-board
expect screen excludes zab-notes

# --- edges sticky ---
key g
key g
expect selected daily 1
expect topline 1
scroll -5
expect topline 0
expect selected daily 1
scroll -1
expect topline 0
expect selected daily 1

key G
expect topline 25
scroll 5
expect topline 25
expect selected zab 3

# --- many notches from the top still hit max ---
key g
key g
scroll -1
expect topline 0
scroll 40
expect topline 25
expect scrollbar thumb 4 5
expect screen contains zab-notes
expect screen excludes daily-review
