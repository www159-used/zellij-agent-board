layout {
    cwd "."
    pane size=1 borderless=true {
        plugin location="zellij:tab-bar"
    }
    pane edit="src/main.rs" size="70%"
    pane
    pane size=1 borderless=true {
        plugin location="zellij:status-bar"
    }
    floating_panes {
        pane {
            plugin location="file:target/wasm32-wasip1/release/agent-board.wasm"
        }
    }
}
